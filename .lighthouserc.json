{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "url": [
        "http://localhost/index.html?bci=accepted",
        "http://localhost/about/index.html?bci=accepted",
        "http://localhost/practice-areas/index.html?bci=accepted",
        "http://localhost/practice-areas/corporate-commercial/index.html?bci=accepted",
        "http://localhost/insights/index.html?bci=accepted",
        "http://localhost/contact/index.html?bci=accepted"
      ],
      "numberOfRuns": 1
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.95 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.95 }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 2000 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.05 }]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
