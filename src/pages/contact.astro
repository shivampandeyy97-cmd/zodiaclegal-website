---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ConsultationForm from '../components/ConsultationForm.astro';
import { SITE_CONFIG } from '../data/siteConfig';
---

<BaseLayout
  title="Contact Zodiac Legal | Pan-India Corporate Legal Consultation"
  description="Schedule a corporate or commercial legal consultation with Zodiac Legal. Call +91 98390 10163, email zodiaclegal.lucknow@gmail.com, or submit an inquiry online."
  canonicalPath="/contact/"
  lastReviewed="2026-10-16"
>
  <section class="hero-obsidian-glow py-14 text-white border-b border-zinc-800">
    <div class="mx-auto max-w-container px-4 sm:px-6 lg:px-8">
      <Breadcrumbs
        items={[{ label: 'Contact & Consultation', href: '/contact/' }]}
        invertText={true}
      />
      <p class="text-xs font-semibold tracking-widest text-amber-400 uppercase">
        Pan-India Corporate &amp; Litigation Desk
      </p>
      <h1 class="mt-2 font-serif text-3xl font-semibold text-white sm:text-4xl">
        Contact Zodiac Legal &amp; Book a Consultation
      </h1>
      <p class="mt-4 max-w-3xl text-base leading-relaxed text-stone-300">
        Appointments for corporate advisory, contract structuring, RERA, and dispute resolution
        across India are scheduled Monday through Saturday after a preliminary conflict-of-interest
        verification.
      </p>
    </div>
  </section>

  <section class="py-12 sm:py-16">
    <div class="mx-auto max-w-container px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 gap-10 lg:grid-cols-12 lg:gap-12">
        <div class="lg:col-span-7">
          <ConsultationForm />
        </div>

        <aside class="space-y-8 lg:col-span-5">
          <!-- Direct Consultation Desk Block -->
          <div class="card-surface rounded border border-border-strong bg-paper-card p-6">
            <h2 class="font-serif text-xl font-semibold text-content-primary">
              Direct Corporate &amp; Litigation Desk
            </h2>
            <address class="mt-4 not-italic space-y-3.5 text-sm text-content-secondary">
              <div>
                <p class="font-semibold text-content-primary">{SITE_CONFIG.nap.firmName}</p>
                <p>Pan-India Corporate, Commercial &amp; Regulatory Practice</p>
              </div>
              <div>
                <p class="font-semibold text-content-primary">Telephone / WhatsApp:</p>
                <p>
                  <a
                    href={`tel:${SITE_CONFIG.nap.phoneE164}`}
                    class="font-bold text-brass underline"
                  >
                    {SITE_CONFIG.nap.phoneDisplay}
                  </a>
                </p>
              </div>
              <div>
                <p class="font-semibold text-content-primary">Official Electronic Mail:</p>
                <p>
                  <a
                    href={`mailto:${SITE_CONFIG.nap.email}`}
                    class="font-bold text-brass underline break-all"
                  >
                    {SITE_CONFIG.nap.email}
                  </a>
                </p>
              </div>
              <div>
                <p class="font-semibold text-content-primary">Consultation Hours:</p>
                <p>{SITE_CONFIG.nap.hours}</p>
              </div>
            </address>
          </div>

          <!-- Pan-India Representation & Virtual Briefing -->
          <div class="card-surface rounded border border-border-subtle bg-paper-warm p-6">
            <h2 class="font-serif text-lg font-semibold text-content-primary">
              Pan-India Representation &amp; Virtual Briefings
            </h2>
            <p class="mt-2 text-xs leading-relaxed text-content-secondary">
              Zodiac Legal advises domestic and international corporations, startups, promoters, and
              lenders across major Indian commercial corridors—including Delhi-NCR, Mumbai,
              Bengaluru, Hyderabad, Chennai, Pune, Kolkata, and Ahmedabad—via structured virtual
              briefings and chamber consultations.
            </p>
            <div class="mt-4 rounded border border-border-strong bg-paper p-5">
              <p class="font-serif text-sm font-semibold text-content-primary">
                Forums &amp; Authorities Covered Nationwide
              </p>
              <p class="mt-1.5 text-xs leading-relaxed text-content-secondary">
                Supreme Court &amp; High Courts • Commercial Courts • NCLT &amp; NCLAT • DRT &amp;
                DRAT • State RERA Authorities • Arbitral Tribunals • MCA / ROC &amp; Consumer
                Commissions.
              </p>
            </div>
          </div>

          <!-- Pre-Consultation Checklist -->
          <div class="card-surface rounded border border-border-subtle bg-paper-card p-6">
            <h2 class="font-serif text-lg font-semibold text-content-primary">
              How to Prepare for Your Consultation
            </h2>
            <ul class="mt-3 space-y-2 text-xs leading-relaxed text-content-secondary">
              <li>• Prepare a 1-page chronological list of key dates and events.</li>
              <li>
                • Keep copies of executed agreements, purchase orders, or property deeds ready.
              </li>
              <li>• Include any statutory notice, bank return memo, or tribunal order received.</li>
              <li>
                • Do not transmit sensitive privileged files until our conflict check is confirmed.
              </li>
            </ul>
          </div>
        </aside>
      </div>
    </div>
  </section>
</BaseLayout>
