---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ConsultationForm from '../components/ConsultationForm.astro';
import { SITE_CONFIG } from '../data/siteConfig';
---

<BaseLayout
  title="Contact Zodiac Legal | Consultation in Vikas Nagar Lucknow"
  description="Schedule a legal consultation with Zodiac Legal in Vikas Nagar, Lucknow, Uttar Pradesh. Call +91 98390 10163 or submit a confidential inquiry online."
  canonicalPath="/contact/"
  lastReviewed="2026-10-16"
>
  <section class="hero-obsidian-glow py-14 text-white border-b border-zinc-800">
    <div class="mx-auto max-w-container px-4 sm:px-6 lg:px-8">
      <Breadcrumbs
        items={[{ label: 'Contact & Consultation', href: '/contact/' }]}
        invertText={true}
      />
      <p class="text-xs font-semibold tracking-widest text-amber-400 uppercase">
        Vikas Nagar, Lucknow • Uttar Pradesh
      </p>
      <h1 class="mt-2 font-serif text-3xl font-semibold text-white sm:text-4xl">
        Contact Zodiac Legal &amp; Book a Consultation
      </h1>
      <p class="mt-4 max-w-3xl text-base leading-relaxed text-stone-300">
        Appointments are scheduled Monday through Saturday after a preliminary conflict-of-interest
        verification.
      </p>
    </div>
  </section>

  <section class="py-16">
    <div class="mx-auto max-w-container px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 gap-12 lg:grid-cols-12">
        <div class="lg:col-span-7">
          <ConsultationForm />
        </div>

        <aside class="space-y-8 lg:col-span-5">
          <!-- Full NAP Block -->
          <div class="card-surface rounded border border-border-strong bg-paper-card p-6">
            <h2 class="font-serif text-xl font-semibold text-content-primary">
              Lucknow Office &amp; Direct Desk
            </h2>
            <address class="mt-4 not-italic space-y-3 text-sm text-content-secondary">
              <div>
                <p class="font-semibold text-content-primary">{SITE_CONFIG.nap.firmName}</p>
                <p>{SITE_CONFIG.nap.streetAddress}</p>
                <p>
                  {SITE_CONFIG.nap.locality}, {SITE_CONFIG.nap.region} – {
                    SITE_CONFIG.nap.postalCode
                  },{' '}
                  {SITE_CONFIG.nap.country}
                </p>
              </div>
              <div>
                <p class="font-semibold text-content-primary">Telephone / WhatsApp:</p>
                <p>
                  <a href={`tel:${SITE_CONFIG.nap.phoneE164}`} class="text-brass underline">
                    {SITE_CONFIG.nap.phoneDisplay}
                  </a>
                </p>
              </div>
              <div>
                <p class="font-semibold text-content-primary">Electronic Mail:</p>
                <p>
                  <a href={`mailto:${SITE_CONFIG.nap.email}`} class="text-brass underline">
                    {SITE_CONFIG.nap.email}
                  </a>
                </p>
              </div>
              <div>
                <p class="font-semibold text-content-primary">Consultation Hours:</p>
                <p>{SITE_CONFIG.nap.hours}</p>
              </div>
            </address>
          </div>

          <!-- Map Embed Placeholder (Privacy-safe & zero third-party CLS) -->
          <div class="card-surface rounded border border-border-subtle bg-paper-warm p-6">
            <h2 class="font-serif text-lg font-semibold text-content-primary">
              Location — Vikas Nagar, Lucknow
            </h2>
            <p class="mt-2 text-xs leading-relaxed text-content-secondary">
              Situated in Vikas Nagar, Lucknow (226022), with convenient connectivity to the High
              Court of Judicature at Allahabad (Lucknow Bench, Gomti Nagar), UP-RERA (Kalakankar
              House Road), and Commercial Courts.
            </p>
            <div class="mt-4 rounded border border-border-strong bg-paper p-5 text-center">
              <p class="font-serif text-sm font-semibold text-content-primary">
                Vikas Nagar, Lucknow, Uttar Pradesh (26.8986° N, 80.9639° E)
              </p>
              <p class="mt-1 text-xs text-content-muted">
                Exact chamber directions are shared upon appointment confirmation.
              </p>
              <a
                href="https://www.google.com/maps/search/?api=1&query=Vikas+Nagar+Lucknow+Uttar+Pradesh+226022"
                target="_blank"
                rel="noopener noreferrer"
                class="mt-3 inline-block rounded bg-ink px-4 py-2 text-xs font-semibold text-white hover:bg-ink-elevated dark:bg-brass dark:text-ink"
              >
                Open Vikas Nagar in Google Maps ↗
              </a>
            </div>
          </div>

          <!-- Pre-Consultation Checklist -->
          <div class="card-surface rounded border border-border-subtle bg-paper-card p-6">
            <h2 class="font-serif text-lg font-semibold text-content-primary">
              How to Prepare for Your Consultation
            </h2>
            <ul class="mt-3 space-y-2 text-xs leading-relaxed text-content-secondary">
              <li>• Prepare a 1-page chronological list of key dates and events.</li>
              <li>
                • Keep copies of executed agreements, purchase orders, or property deeds ready.
              </li>
              <li>• Bring any statutory notice, bank return memo, or tribunal order received.</li>
              <li>
                • Do not transmit sensitive privileged files until our conflict check is confirmed.
              </li>
            </ul>
          </div>
        </aside>
      </div>
    </div>
  </section>
</BaseLayout>
