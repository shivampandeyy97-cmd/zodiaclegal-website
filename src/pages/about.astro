---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ConsultationForm from '../components/ConsultationForm.astro';
import { SITE_CONFIG } from '../data/siteConfig';
---

<BaseLayout
  title="About Zodiac Legal | Corporate Law Practice in Lucknow"
  description="Learn about Zodiac Legal's corporate, commercial, real estate (UP-RERA), and dispute resolution practice in Vikas Nagar, Lucknow, Uttar Pradesh."
  canonicalPath="/about/"
  lastReviewed="2026-10-16"
>
  <section class="bg-ink py-14 text-content-inverse border-b border-stone-800">
    <div class="mx-auto max-w-container px-4 sm:px-6 lg:px-8">
      <Breadcrumbs items={[{ label: 'About the Firm', href: '/about/' }]} invertText={true} />
      <p class="text-xs font-semibold tracking-widest text-brass-light uppercase">
        Firm Profile &amp; Governance
      </p>
      <h1 class="mt-2 font-serif text-3xl font-semibold text-white sm:text-4xl">
        About Zodiac Legal — Lucknow, Uttar Pradesh
      </h1>
      <p class="mt-4 max-w-3xl text-base leading-relaxed text-stone-300">
        A structured corporate advisory, commercial documentation, and statutory dispute resolution
        practice serving businesses, promoters, creditors, and property owners in Uttar Pradesh.
      </p>
    </div>
  </section>

  <section class="py-16">
    <div class="mx-auto max-w-container px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 gap-12 lg:grid-cols-12">
        <div class="legal-prose lg:col-span-7">
          <h2>How is Zodiac Legal structured and who does the firm advise?</h2>
          <p>
            <strong>Zodiac Legal</strong> is a legal consultancy and representation practice based in
            <strong>Vikas Nagar, Lucknow, Uttar Pradesh</strong> (historically referenced in regional
            directory profiles as a legal unit associated with Shashwat Global Services). We advise private
            limited companies, LLPs, MSMEs, startups, real estate allottees, and commercial creditors
            across Uttar Pradesh.
          </p>
          <p>
            Whether an enterprise is incorporating under the jurisdiction of the Registrar of
            Companies (ROC Kanpur), negotiating a multi-year commercial supply contract, defending a
            regulatory notice, or pursuing statutory debt recovery before NCLT Allahabad, DRT
            Lucknow, or the Commercial Courts, our practice desks prioritize statutory accuracy,
            exhaustive documentation verification, and clear written advice.
          </p>

          <h2>What principles govern our legal practice?</h2>
          <ul>
            <li>
              <strong>Documentation First:</strong> Commercial disputes in India are overwhelmingly
              decided on documentary records—executed contracts, e-stamp compliance, statutory
              demand notices, ledger acknowledgements, and board resolutions. We structure both
              transactional and litigation files around verifiable documentary evidence.
            </li>
            <li>
              <strong>Plain-English Risk Assessment:</strong> Clients receive direct, checkable
              explanations of statutory timelines, forum jurisdiction, and procedural dependencies
              rather than opaque legalese.
            </li>
            <li>
              <strong>Strict Bar Council of India Compliance:</strong> In accordance with Rule 36 of
              the Bar Council of India Rules, Zodiac Legal does not engage in comparative claims,
              outcome guarantees, or solicitation. All court and tribunal appearances are conducted
              by duly enrolled Advocates.
            </li>
          </ul>

          <h2>Standard Institutional Descriptions (For Directories &amp; Citations)</h2>
          <h3>50-Word Firm Description</h3>
          <blockquote>
            {SITE_CONFIG.descriptions.short50}
          </blockquote>

          <h3>150-Word Firm Description</h3>
          <blockquote>
            {SITE_CONFIG.descriptions.standard150}
          </blockquote>

          <p class="text-xs text-content-muted">
            <em>
              Last Reviewed: 16 October 2026 • Reviewed by Zodiac Legal Corporate &amp; Litigation
              Desk, Lucknow. Informational only; not legal advice.
            </em>
          </p>
        </div>

        <aside class="space-y-8 lg:col-span-5">
          <div class="card-surface rounded border border-border-strong bg-paper-card p-6">
            <h2 class="font-serif text-xl font-semibold text-content-primary">
              Primary Forums &amp; Authorities in Uttar Pradesh
            </h2>
            <p class="mt-2 text-xs text-content-secondary">
              Our practice desks handle filings, appearances, and compliance before:
            </p>
            <ul class="mt-4 space-y-2.5 text-sm text-content-secondary">
              {
                SITE_CONFIG.jurisdictions.map((forum) => (
                  <li class="flex items-start gap-2">
                    <span class="text-brass" aria-hidden="true">▪</span>
                    <span>{forum}</span>
                  </li>
                ))
              }
            </ul>
          </div>

          <div class="card-surface rounded border border-border-subtle bg-paper-warm p-6">
            <h2 class="font-serif text-lg font-semibold text-content-primary">
              Verified Office &amp; Contact Information
            </h2>
            <dl class="mt-3 space-y-2 text-sm text-content-secondary">
              <div>
                <dt class="font-semibold text-content-primary">Location:</dt>
                <dd>
                  {SITE_CONFIG.nap.streetAddress}, {SITE_CONFIG.nap.locality},{' '}
                  {SITE_CONFIG.nap.region} – {SITE_CONFIG.nap.postalCode}
                </dd>
              </div>
              <div>
                <dt class="font-semibold text-content-primary">Telephone:</dt>
                <dd>
                  <a href={`tel:${SITE_CONFIG.nap.phoneE164}`} class="text-brass underline">
                    {SITE_CONFIG.nap.phoneDisplay}
                  </a>
                </dd>
              </div>
              <div>
                <dt class="font-semibold text-content-primary">Email:</dt>
                <dd>
                  <a href={`mailto:${SITE_CONFIG.nap.email}`} class="text-brass underline">
                    {SITE_CONFIG.nap.email}
                  </a>
                </dd>
              </div>
              <div>
                <dt class="font-semibold text-content-primary">Hours:</dt>
                <dd>{SITE_CONFIG.nap.hours}</dd>
              </div>
            </dl>
          </div>

          <ConsultationForm compact={true} />
        </aside>
      </div>
    </div>
  </section>
</BaseLayout>
