---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { SITE_CONFIG } from '../data/siteConfig';
---

<BaseLayout
  title="Privacy Policy & DPDP Act Notice | Zodiac Legal"
  description="Privacy Policy of Zodiac Legal (Lucknow, Uttar Pradesh) under the Information Technology Act, 2000 and the Digital Personal Data Protection Act, 2023."
  canonicalPath="/privacy-policy/"
  lastReviewed="2026-10-16"
>
  <section class="hero-obsidian-glow py-12 text-white border-b border-zinc-800">
    <div class="mx-auto max-w-container px-4 sm:px-6 lg:px-8">
      <Breadcrumbs
        items={[{ label: 'Privacy Policy', href: '/privacy-policy/' }]}
        invertText={true}
      />
      <h1 class="mt-2 font-serif text-3xl font-semibold text-white">
        Privacy Policy &amp; Data Protection Notice
      </h1>
      <p class="mt-2 text-xs text-stone-300">
        Effective &amp; Last Reviewed: 16 October 2026 • Compliant with the Digital Personal Data
        Protection Act, 2023 (DPDP Act)
      </p>
    </div>
  </section>

  <section class="py-14">
    <div class="mx-auto max-w-container px-4 sm:px-6 lg:px-8">
      <div class="legal-prose">
        <h2>1. Scope and Data Fiduciary Identity</h2>
        <p>
          <strong>{SITE_CONFIG.name}</strong>, located at {SITE_CONFIG.nap.streetAddress},{' '}
          {SITE_CONFIG.nap.locality}, {SITE_CONFIG.nap.region} – {SITE_CONFIG.nap.postalCode},
          India, respects the privacy of visitors to <code>zodiaclegal.com</code> and processes personal
          data in accordance with the Information Technology Act, 2000 and the Digital Personal Data Protection
          Act, 2023 (“DPDP Act”).
        </p>

        <h2>2. Categories of Personal Data Collected</h2>
        <p>
          We collect personal data strictly when you voluntarily submit a consultation request or
          contact our desk directly:
        </p>
        <ul>
          <li>Full Name and Organization / Entity Name;</li>
          <li>Telephone / WhatsApp Number and Electronic Mail Address;</li>
          <li>Selected Practice Area and non-confidential summary of your legal inquiry;</li>
          <li>
            Technical server logs (IP address and user-agent string) processed transiently for rate
            limiting and security protection.
          </li>
        </ul>

        <h2>3. Purpose of Processing &amp; Lawful Basis</h2>
        <p>Your personal data is processed solely for the following specified purposes:</p>
        <ul>
          <li>Performing preliminary conflict-of-interest checks;</li>
          <li>Responding to your request to schedule a legal consultation;</li>
          <li>Complying with applicable statutory or Bar Council of India obligations.</li>
        </ul>
        <p>
          We never sell, rent, or trade visitor or client personal data to third-party advertisers
          or data brokers.
        </p>

        <h2>4. Rights of Data Principals under the DPDP Act, 2023</h2>
        <p>
          Subject to statutory exceptions applicable to legal proceedings and professional
          confidentiality, you have the right to request access to, correction of, or erasure of
          personal data submitted through this website, and to withdraw consent by writing to{' '}
          <a href={`mailto:${SITE_CONFIG.nap.email}`}>{SITE_CONFIG.nap.email}</a>.
        </p>

        <h2>5. Analytics &amp; Cookies</h2>
        <p>
          This website stores a local preference key (<code>zodiaclegal_bci_acknowledged_v1</code>)
          in your browser’s <code>localStorage</code> to remember your acknowledgement of the Bar Council
          of India disclaimer. Optional analytics, when configured, load only after user acknowledgement.
        </p>

        <p class="text-xs text-content-muted">
          <em>Informational only; not legal advice.</em>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
