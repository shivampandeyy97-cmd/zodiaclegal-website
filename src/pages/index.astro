---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import ConsultationForm from '../components/ConsultationForm.astro';
import { SITE_CONFIG } from '../data/siteConfig';

const practiceAreas = (await getCollection('practice-areas')).sort(
  (a, b) => a.data.order - b.data.order
);
const insights = (await getCollection('insights')).slice(0, 6);
const faqGroups = (await getCollection('faqs')).sort((a, b) => a.data.order - b.data.order);
const mandates = (await getCollection('testimonials')).sort((a, b) => a.data.order - b.data.order);

const homeFaqs = faqGroups.flatMap((group) => group.data.items).slice(0, 6);

const processSteps = [
  {
    number: '01',
    title: 'Conflict Check & Document Review',
    description:
      'We verify party names for conflict of interest and review your contracts, notices, or property records chronologically.',
  },
  {
    number: '02',
    title: 'Statutory & Forum Assessment',
    description:
      'We identify the governing statute, limitation deadlines, and appropriate forum in Lucknow or Uttar Pradesh (ROC, UP-RERA, DRT, NCLT, Commercial Court, or High Court).',
  },
  {
    number: '03',
    title: 'Written Scope & Strategy Note',
    description:
      'Before initiating drafting or filing, we provide a plain-English scope of work, document checklist, and stage-wise procedural roadmap.',
  },
  {
    number: '04',
    title: 'Execution, Filing & Representation',
    description:
      'Our practice desks draft the transactional instruments or pleadings and represent your interests with structured status updates at every stage.',
  },
];
---

<BaseLayout
  title="Zodiac Legal | Corporate & Commercial Lawyers in Lucknow"
  description="Zodiac Legal is a corporate, commercial, real estate (UP-RERA), and dispute resolution law practice in Vikas Nagar, Lucknow, Uttar Pradesh."
  canonicalPath="/"
  lastReviewed="2026-10-16"
>
  <!-- Dark Ink Hero Section -->
  <section class="relative overflow-hidden bg-ink text-content-inverse border-b border-stone-800">
    <div class="mx-auto max-w-container px-4 py-16 sm:px-6 lg:py-24 lg:px-8">
      <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-12">
        <div class="lg:col-span-7">
          <p class="inline-flex items-center gap-2 rounded-sm border border-stone-700 bg-ink-elevated px-3 py-1 text-xs font-semibold tracking-widest text-brass-light uppercase">
            <span>Vikas Nagar, Lucknow • Uttar Pradesh</span>
          </p>
          <h1
            class="mt-6 font-serif text-3xl font-semibold tracking-tight text-white sm:text-4xl lg:text-[2.85rem] lg:leading-[1.15]"
          >
            Corporate Counsel, Commercial Contracts &amp; Statutory Representation in Lucknow.
          </h1>
          <p class="mt-5 max-w-2xl text-base leading-relaxed text-stone-300 sm:text-lg">
            Zodiac Legal advises companies, promoters, startups, financial creditors, and property
            owners across Uttar Pradesh on corporate governance, contract architecture, UP-RERA,
            arbitration, and debt recovery.
          </p>

          <div class="mt-8 flex flex-wrap items-center gap-4">
            <a
              href="/contact/#consultation-form"
              class="rounded-sm bg-brass-light px-6 py-3.5 text-xs font-semibold tracking-wider text-ink uppercase transition-colors hover:bg-white"
            >
              Book a Consultation
            </a>
            <a
              href="/practice-areas/"
              class="rounded-sm border border-stone-600 bg-ink-elevated px-6 py-3.5 text-xs font-semibold tracking-wider text-stone-100 uppercase transition-colors hover:border-brass-light hover:text-brass-light"
            >
              Explore Practice Areas
            </a>
          </div>

          <p class="mt-6 text-xs text-stone-400">
            Informational only; not legal advice or solicitation under Rule 36 of the Bar Council of
            India Rules.
          </p>
        </div>

        <div class="hidden lg:col-span-5 lg:block">
          <div class="rounded border border-stone-800 bg-ink-elevated p-3 shadow-2xl">
            <img
              src="/images/architectural-grid.svg"
              alt="Architectural structural geometry representing Zodiac Legal's practice framework"
              width="800"
              height="600"
              fetchpriority="high"
              class="h-auto w-full rounded-sm"
            />
          </div>
        </div>
      </div>
    </div>

    <!-- Verifiable Scope & Jurisdictional Strip (No invented stats or superlative claims) -->
    <div class="border-t border-stone-800 bg-ink-elevated/90">
      <div class="mx-auto max-w-container px-4 py-6 sm:px-6 lg:px-8">
        <dl class="grid grid-cols-2 gap-6 sm:grid-cols-4">
          <div class="border-s-2 border-brass-light ps-4">
            <dt class="text-xs font-medium tracking-wider text-stone-400 uppercase">
              Practice Desks
            </dt>
            <dd class="mt-1 font-serif text-xl font-semibold text-white">9 Core Areas</dd>
          </div>
          <div class="border-s-2 border-brass-light ps-4">
            <dt class="text-xs font-medium tracking-wider text-stone-400 uppercase">
              Primary Seat
            </dt>
            <dd class="mt-1 font-serif text-xl font-semibold text-white">Lucknow, UP</dd>
          </div>
          <div class="border-s-2 border-brass-light ps-4">
            <dt class="text-xs font-medium tracking-wider text-stone-400 uppercase">
              Statutory Guides
            </dt>
            <dd class="mt-1 font-serif text-xl font-semibold text-white">10 In-Depth Briefs</dd>
          </div>
          <div class="border-s-2 border-brass-light ps-4">
            <dt class="text-xs font-medium tracking-wider text-stone-400 uppercase">
              Languages
            </dt>
            <dd class="mt-1 font-serif text-xl font-semibold text-white">English &amp; Hindi</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <!-- Answer-First Firm Overview & Legacy Preservation Section -->
  <section class="border-b border-border-subtle bg-paper py-16 sm:py-20">
    <div class="mx-auto max-w-container px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 gap-12 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <p class="text-xs font-semibold tracking-widest text-brass uppercase">
            Institutional Overview
          </p>
          <h2 class="mt-2 font-serif text-2xl font-semibold text-content-primary sm:text-3xl">
            What legal services does Zodiac Legal provide in Lucknow?
          </h2>
          <p class="mt-4 text-sm leading-relaxed text-content-secondary">
            {SITE_CONFIG.descriptions.short50}
          </p>
          <div class="mt-6 rounded border border-border-subtle bg-paper-warm p-4 text-xs leading-relaxed text-content-secondary">
            <p class="font-semibold text-content-primary">Preserved Legacy Practice Note:</p>
            <p class="mt-1">
              Zodiac Legal operates from Vikas Nagar, Lucknow, Uttar Pradesh (associated in regional
              directory records with Shashwat Global Services), providing consulting, documentation,
              and legal representation across Corporate Law, Commercial Contracts, Consumer Laws,
              Debt Recovery, Real Estate, and Dispute Resolution.
            </p>
          </div>
        </div>

        <div class="lg:col-span-7">
          <h3 class="font-serif text-xl font-semibold text-content-primary">
            Who We Serve Across Uttar Pradesh
          </h3>
          <div class="mt-5 grid grid-cols-1 gap-4 sm:grid-cols-2">
            <div class="card-surface rounded border border-border-subtle bg-paper-card p-5">
              <h4 class="font-serif text-base font-semibold text-content-primary">
                Private Limited Companies &amp; LLPs
              </h4>
              <p class="mt-2 text-sm text-content-secondary">
                Entity incorporation under ROC Kanpur, board governance, vendor master service
                agreements, and statutory compliance under the Companies Act, 2013.
              </p>
            </div>
            <div class="card-surface rounded border border-border-subtle bg-paper-card p-5">
              <h4 class="font-serif text-base font-semibold text-content-primary">
                Startups, Founders &amp; MSMEs
              </h4>
              <p class="mt-2 text-sm text-content-secondary">
                Founders’ agreements, equity vesting, DPIIT recognition, trademark filing, and
                delayed payment recovery before the UP MSEFC (MSME Samadhaan).
              </p>
            </div>
            <div class="card-surface rounded border border-border-subtle bg-paper-card p-5">
              <h4 class="font-serif text-base font-semibold text-content-primary">
                Creditors &amp; Commercial Litigants
              </h4>
              <p class="mt-2 text-sm text-content-secondary">
                Section 138 NI Act cheque bounce prosecutions, domestic commercial arbitration, DRT
                Lucknow SARFAESI matters, and NCLT Allahabad insolvency petitions.
              </p>
            </div>
            <div class="card-surface rounded border border-border-subtle bg-paper-card p-5">
              <h4 class="font-serif text-base font-semibold text-content-primary">
                Real Estate Allottees &amp; Lessors
              </h4>
              <p class="mt-2 text-sm text-content-secondary">
                30-year chain-of-title searches in Lucknow, commercial lease deeds, conveyance
                drafting, and homebuyer/promoter proceedings before UP-RERA.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Practice Areas Grid -->
  <section class="section-deferred border-b border-border-subtle bg-paper-warm py-16 sm:py-20">
    <div class="mx-auto max-w-container px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
        <div>
          <p class="text-xs font-semibold tracking-widest text-brass uppercase">
            Areas of Practice
          </p>
          <h2 class="mt-1 font-serif text-2xl font-semibold text-content-primary sm:text-3xl">
            Practice Desks &amp; Statutory Representation
          </h2>
        </div>
        <a
          href="/practice-areas/"
          class="text-sm font-semibold text-brass hover:underline"
        >
          View Complete Practice Index →
        </a>
      </div>

      <div class="mt-10 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
        {
          practiceAreas.map((area) => (
            <article class="card-surface flex flex-col justify-between rounded border border-border-subtle bg-paper-card p-6 transition-colors hover:border-border-strong">
              <div>
                <p class="text-xs font-semibold tracking-wider text-brass uppercase">
                  {area.data.category}
                </p>
                <h3 class="mt-2 font-serif text-xl font-semibold text-content-primary">
                  <a href={`/practice-areas/${area.slug}/`} class="hover:text-brass">
                    {area.data.title}
                  </a>
                </h3>
                <p class="mt-3 text-sm leading-relaxed text-content-secondary">
                  {area.data.summary}
                </p>
              </div>
              <div class="mt-6 border-t border-border-subtle pt-4">
                <p class="text-xs text-content-muted">
                  <strong class="text-content-primary">Key Statutes:</strong>{' '}
                  {area.data.statutesCovered.slice(0, 2).join(' • ')}
                </p>
                <a
                  href={`/practice-areas/${area.slug}/`}
                  class="mt-3 inline-flex items-center text-xs font-semibold tracking-wider text-brass uppercase hover:underline"
                >
                  Read Practice Guide &amp; Checklist →
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Process Timeline ("How We Work") -->
  <section class="section-deferred border-b border-border-subtle bg-paper py-16 sm:py-20">
    <div class="mx-auto max-w-container px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl">
        <p class="text-xs font-semibold tracking-widest text-brass uppercase">
          Procedural Clarity
        </p>
        <h2 class="mt-1 font-serif text-2xl font-semibold text-content-primary sm:text-3xl">
          How does Zodiac Legal structure a legal engagement?
        </h2>
        <p class="mt-3 text-sm leading-relaxed text-content-secondary">
          Every corporate transaction and litigation mandate follows a four-stage workflow designed
          to eliminate procedural surprises and maintain strict statutory timelines.
        </p>
      </div>

      <ol class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          processSteps.map((step) => (
            <li class="card-surface rounded border border-border-subtle bg-paper-card p-6">
              <span class="font-mono text-xs font-bold tracking-widest text-brass">
                STAGE {step.number}
              </span>
              <h3 class="mt-2 font-serif text-lg font-semibold text-content-primary">
                {step.title}
              </h3>
              <p class="mt-2.5 text-sm leading-relaxed text-content-secondary">
                {step.description}
              </p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Representative Mandates & Jurisdictional Coverage -->
  <section class="section-deferred border-b border-border-subtle bg-paper-warm py-16 sm:py-20">
    <div class="mx-auto max-w-container px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 gap-12 lg:grid-cols-12">
        <div class="lg:col-span-6">
          <p class="text-xs font-semibold tracking-widest text-brass uppercase">
            Judicial &amp; Regulatory Forums
          </p>
          <h2 class="mt-1 font-serif text-2xl font-semibold text-content-primary sm:text-3xl">
            Courts, Tribunals &amp; Authorities in Uttar Pradesh
          </h2>
          <p class="mt-3 text-sm leading-relaxed text-content-secondary">
            Our Lucknow practice desks appear before and coordinate filings across the primary judicial,
            quasi-judicial, and regulatory authorities governing commercial operations in Uttar
            Pradesh:
          </p>
          <ul class="mt-5 space-y-2.5 text-sm text-content-secondary">
            {
              SITE_CONFIG.jurisdictions.map((forum) => (
                <li class="flex items-start gap-2.5">
                  <span class="mt-1 text-brass" aria-hidden="true">▪</span>
                  <span>{forum}</span>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="lg:col-span-6">
          <p class="text-xs font-semibold tracking-widest text-brass uppercase">
            Representative Work Scope
          </p>
          <h2 class="mt-1 font-serif text-2xl font-semibold text-content-primary sm:text-3xl">
            Illustrative Matter Categories
          </h2>
          <p class="mt-2 text-xs text-content-muted">
            Presented in anonymized summary format in adherence to Bar Council of India rules.
          </p>
          <div class="mt-5 space-y-4">
            {
              mandates.map((item) => (
                <div class="card-surface rounded border border-border-subtle bg-paper-card p-5">
                  <div class="flex flex-wrap items-center justify-between gap-2">
                    <span class="text-xs font-semibold text-brass uppercase">
                      {item.data.sector}
                    </span>
                    <span class="text-xs text-content-muted">{item.data.clientLabel}</span>
                  </div>
                  <h3 class="mt-1.5 font-serif text-base font-semibold text-content-primary">
                    {item.data.matterType}
                  </h3>
                  <p class="mt-1.5 text-sm text-content-secondary">{item.data.engagementNote}</p>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Latest Statutory Insights -->
  <section class="section-deferred border-b border-border-subtle bg-paper py-16 sm:py-20">
    <div class="mx-auto max-w-container px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
        <div>
          <p class="text-xs font-semibold tracking-widest text-brass uppercase">
            Knowledge Hub
          </p>
          <h2 class="mt-1 font-serif text-2xl font-semibold text-content-primary sm:text-3xl">
            Statutory Guides &amp; Legal Insights
          </h2>
        </div>
        <a href="/insights/" class="text-sm font-semibold text-brass hover:underline">
          Browse All 10 Legal Guides →
        </a>
      </div>

      <div class="mt-10 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
        {
          insights.map((post) => (
            <article class="card-surface flex flex-col justify-between rounded border border-border-subtle bg-paper-card p-6">
              <div>
                <div class="flex items-center gap-2 text-xs text-content-muted">
                  <span class="font-semibold text-brass uppercase">{post.data.category}</span>
                  <span aria-hidden="true">•</span>
                  <span>{post.data.readingTime}</span>
                </div>
                <h3 class="mt-2 font-serif text-lg font-semibold text-content-primary">
                  <a href={`/insights/${post.slug}/`} class="hover:text-brass">
                    {post.data.title}
                  </a>
                </h3>
                <p class="mt-2.5 text-sm leading-relaxed text-content-secondary line-clamp-3">
                  {post.data.directAnswer}
                </p>
              </div>
              <div class="mt-5 border-t border-border-subtle pt-3 flex items-center justify-between text-xs text-content-muted">
                <span>Reviewed: {post.data.lastReviewed}</span>
                <a
                  href={`/insights/${post.slug}/`}
                  class="font-semibold text-brass hover:underline"
                >
                  Read Guide →
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Frequently Asked Questions & Consultation Form -->
  <section class="section-deferred bg-paper-warm py-16 sm:py-20">
    <div class="mx-auto max-w-container px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 gap-12 lg:grid-cols-12">
        <div class="lg:col-span-6">
          <p class="text-xs font-semibold tracking-widest text-brass uppercase">
            Direct Answers (AEO / FAQ)
          </p>
          <h2 class="mt-1 font-serif text-2xl font-semibold text-content-primary sm:text-3xl">
            Frequently Asked Questions
          </h2>
          <p class="mt-2 mb-6 text-sm text-content-secondary">
            Concise procedural answers regarding corporate compliance, UP-RERA, debt recovery, and
            legal consultations in Lucknow.
          </p>
          <FaqAccordion items={homeFaqs} groupName="home-faq" emitSchema={true} />
          <div class="mt-6">
            <a href="/faq/" class="text-sm font-semibold text-brass hover:underline">
              View All Frequently Asked Questions →
            </a>
          </div>
        </div>

        <div class="lg:col-span-6">
          <ConsultationForm compact={true} />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
