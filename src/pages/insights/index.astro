---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';

const insights = (await getCollection('insights')).sort((a, b) =>
  b.data.publishDate.localeCompare(a.data.publishDate)
);

const categories = Array.from(new Set(insights.map((item) => item.data.category)));
---

<BaseLayout
  title="Legal Insights & Statutory Guides | Zodiac Legal India"
  description="Read 10 in-depth legal guides on company incorporation in India, commercial contracts, Section 138 cheque bounce, RERA complaints, trademarks, and NCLT."
  canonicalPath="/insights/"
  lastReviewed="2026-10-16"
>
  <section class="hero-obsidian-glow py-14 text-white border-b border-zinc-800">
    <div class="mx-auto max-w-container px-4 sm:px-6 lg:px-8">
      <Breadcrumbs items={[{ label: 'Legal Insights', href: '/insights/' }]} invertText={true} />
      <p class="text-xs font-semibold tracking-widest text-amber-400 uppercase">
        Statutory Knowledge Hub • Pan-India Practice
      </p>
      <h1 class="mt-2 font-serif text-3xl font-semibold text-white sm:text-4xl">
        Legal Insights &amp; Procedural Guides
      </h1>
      <p class="mt-4 max-w-3xl text-base leading-relaxed text-stone-300">
        Plain-English statutory briefings prepared by Zodiac Legal’s practice desks covering
        corporate compliance, contract enforceability, RERA, arbitration, and debt recovery across
        India.
      </p>
    </div>
  </section>

  <section class="py-16">
    <div class="mx-auto max-w-container px-4 sm:px-6 lg:px-8">
      <!-- Category Filter Pills -->
      <div
        class="mb-10 flex flex-wrap items-center gap-2"
        role="region"
        aria-label="Filter insights by category"
      >
        <span class="me-2 text-xs font-semibold tracking-wider text-content-muted uppercase">
          Topics:
        </span>
        {
          categories.map((cat) => (
            <span class="rounded-sm border border-border-strong bg-paper-warm px-3 py-1 text-xs font-medium text-content-primary">
              {cat}
            </span>
          ))
        }
      </div>

      <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
        {
          insights.map((post) => (
            <article class="card-surface flex flex-col justify-between rounded border border-border-subtle bg-paper-card p-6 sm:p-7 hover:border-border-strong">
              <div>
                <div class="flex flex-wrap items-center gap-2 text-xs text-content-muted">
                  <span class="font-semibold text-brass uppercase">{post.data.category}</span>
                  <span aria-hidden="true">•</span>
                  <span>{post.data.readingTime}</span>
                  <span aria-hidden="true">•</span>
                  <span>Reviewed: {post.data.lastReviewed}</span>
                </div>

                <h2 class="mt-3 font-serif text-xl font-semibold text-content-primary sm:text-2xl">
                  <a href={`/insights/${post.slug}/`} class="hover:text-brass">
                    {post.data.title}
                  </a>
                </h2>

                <p class="mt-3 text-sm leading-relaxed text-content-secondary">
                  {post.data.directAnswer}
                </p>

                <div class="mt-4 rounded bg-paper-warm p-3.5">
                  <p class="text-xs font-semibold text-content-primary">Key Takeaways:</p>
                  <ul class="mt-1.5 space-y-1 text-xs text-content-secondary">
                    {post.data.keyTakeaways.slice(0, 2).map((point) => (
                      <li>• {point}</li>
                    ))}
                  </ul>
                </div>
              </div>

              <div class="mt-6 flex items-center justify-between border-t border-border-subtle pt-4 text-xs">
                <a
                  href={`/practice-areas/${post.data.practiceAreaSlug}/`}
                  class="text-content-muted hover:text-brass underline"
                >
                  Related Practice Desk
                </a>
                <a
                  href={`/insights/${post.slug}/`}
                  class="font-semibold tracking-wider text-brass uppercase hover:underline"
                >
                  Read Full Guide →
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
