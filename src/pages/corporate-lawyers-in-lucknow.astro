---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import ConsultationForm from '../components/ConsultationForm.astro';
import { PRACTICE_AREAS_NAV, SITE_CONFIG } from '../data/siteConfig';

const localFaqs = [
  {
    question: 'Which courts and tribunals in Lucknow handle commercial and corporate disputes?',
    answer:
      'Commercial disputes in Lucknow are adjudicated before the Commercial Courts (for specified value disputes under the Commercial Courts Act, 2015), the High Court of Judicature at Allahabad (Lucknow Bench in Gomti Nagar) for writ, arbitration (Section 11/37), and appellate matters, DRT Lucknow for banking recovery, and UP-RERA Lucknow for real estate disputes. Insolvency matters under the IBC for Uttar Pradesh companies are heard at the NCLT Allahabad Bench.',
  },
  {
    question: 'Where are companies incorporated in Lucknow registered under the MCA?',
    answer:
      'While name reservation and SPICe+ (INC-32) incorporation forms are processed through the MCA Central Registration Centre (CRC), the jurisdictional Registrar of Companies for entities with registered offices in Lucknow and across Uttar Pradesh is the Registrar of Companies, Uttar Pradesh (located in Kanpur).',
  },
  {
    question: 'Can Zodiac Legal assist out-of-state companies with litigation or property due diligence in Lucknow?',
    answer:
      'Yes. We regularly represent enterprises headquartered in Delhi-NCR, Mumbai, Bengaluru, and other states in commercial recovery, arbitration, UP-RERA complaints, and 30-year property title searches within Lucknow and Uttar Pradesh.',
  },
];
---

<BaseLayout
  title="Corporate Lawyers in Lucknow, Uttar Pradesh | Zodiac Legal"
  description="Corporate, commercial contract, UP-RERA, arbitration, and debt recovery lawyers in Vikas Nagar, Lucknow, Uttar Pradesh. View forums, statutes, and process."
  canonicalPath="/corporate-lawyers-in-lucknow/"
  lastReviewed="2026-10-16"
>
  <section class="bg-ink py-14 text-content-inverse border-b border-stone-800">
    <div class="mx-auto max-w-container px-4 sm:px-6 lg:px-8">
      <Breadcrumbs
        items={[
          { label: 'Corporate Lawyers in Lucknow', href: '/corporate-lawyers-in-lucknow/' },
        ]}
        invertText={true}
      />
      <p class="text-xs font-semibold tracking-widest text-brass-light uppercase">
        Regional Legal Guide • Lucknow &amp; Uttar Pradesh
      </p>
      <h1 class="mt-2 font-serif text-3xl font-semibold text-white sm:text-4xl">
        Corporate &amp; Commercial Legal Representation in Lucknow, Uttar Pradesh
      </h1>
      <p class="mt-4 max-w-3xl text-base leading-relaxed text-stone-300">
        A practical guide to commercial courts, regulatory authorities, corporate compliance, and
        dispute resolution for enterprises operating in Lucknow and Uttar Pradesh.
      </p>
    </div>
  </section>

  <section class="py-16">
    <div class="mx-auto max-w-container px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 gap-12 lg:grid-cols-12">
        <div class="legal-prose lg:col-span-8">
          <h2>How does the corporate and commercial legal landscape work in Lucknow?</h2>
          <p>
            As the administrative and judicial capital of Uttar Pradesh, <strong>Lucknow</strong> hosts
            the principal benches of key constitutional, commercial, and regulatory forums—including
            the <strong>Lucknow Bench of the High Court of Judicature at Allahabad</strong> (Vibhuti
            Khand, Gomti Nagar), the <strong>Commercial Courts</strong>, the{' '}
            <strong>Uttar Pradesh Real Estate Regulatory Authority (UP-RERA)</strong>, the{' '}
            <strong>Debts Recovery Tribunal (DRT Lucknow)</strong>, and the{' '}
            <strong>Uttar Pradesh State Consumer Disputes Redressal Commission (SCDRC)</strong>.
          </p>
          <p>
            From our office in <strong>Vikas Nagar, Lucknow</strong>, Zodiac Legal advises businesses
            operating across Lucknow’s primary commercial and industrial zones—including Gomti
            Nagar, Hazratganj, Vibhuti Khand, Indira Nagar, Aliganj, Transport Nagar, and the
            Amausi/Nadarganj industrial corridors—as well as out-of-state corporations with
            contracts, debtors, or real estate assets in Uttar Pradesh.
          </p>

          <h2>Key Judicial &amp; Regulatory Forums in Lucknow and Uttar Pradesh</h2>
          <table>
            <thead>
              <tr>
                <th>Forum / Authority</th>
                <th>Primary Statutory Jurisdiction</th>
                <th>Seat / Location</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><strong>High Court (Lucknow Bench)</strong></td>
                <td>Writ petitions (Art. 226), Sec. 11 arbitrator appointments, commercial appeals</td>
                <td>Gomti Nagar, Lucknow</td>
              </tr>
              <tr>
                <td><strong>Commercial Courts</strong></td>
                <td>Commercial disputes under Commercial Courts Act, 2015 &amp; Sec. 9/34 Arbitration</td>
                <td>Lucknow</td>
              </tr>
              <tr>
                <td><strong>UP-RERA &amp; REAT</strong></td>
                <td>Real estate project complaints, possession delay interest, refund &amp; appeals</td>
                <td>Lucknow</td>
              </tr>
              <tr>
                <td><strong>Debts Recovery Tribunal (DRT)</strong></td>
                <td>SARFAESI Act, 2002 Sec. 17 applications &amp; RDB Act recovery applications</td>
                <td>Lucknow</td>
              </tr>
              <tr>
                <td><strong>NCLT Allahabad Bench</strong></td>
                <td>Corporate insolvency (IBC Sec. 7, 9) &amp; Companies Act oppression/mismanagement</td>
                <td>Prayagraj (UP Jurisdiction)</td>
              </tr>
              <tr>
                <td><strong>ROC Uttar Pradesh</strong></td>
                <td>Companies Act, 2013 &amp; LLP Act filings, charges, and compliance</td>
                <td>Kanpur (UP Jurisdiction)</td>
              </tr>
            </tbody>
          </table>

          <h2>Core Corporate &amp; Litigation Services Offered in Lucknow</h2>
          <ul>
            {
              PRACTICE_AREAS_NAV.map((area) => (
                <li>
                  <a href={`/practice-areas/${area.slug}/`} class="font-semibold text-brass underline">
                    {area.title}
                  </a>
                  : {area.shortDesc}
                </li>
              ))
            }
          </ul>

          <div class="mt-10">
            <h2>Frequently Asked Questions — Legal Matters in Lucknow</h2>
            <FaqAccordion items={localFaqs} groupName="lucknow-faq" emitSchema={true} />
          </div>

          <p class="mt-8 text-xs text-content-muted">
            <em>
              Last Reviewed: 16 October 2026 • Reviewed by {SITE_CONFIG.name} Corporate &amp;
              Litigation Desk, Lucknow. Informational only; not legal advice.
            </em>
          </p>
        </div>

        <aside class="lg:col-span-4">
          <ConsultationForm compact={true} />
        </aside>
      </div>
    </div>
  </section>
</BaseLayout>
