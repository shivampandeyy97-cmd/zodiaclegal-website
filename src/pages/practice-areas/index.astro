---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ConsultationForm from '../../components/ConsultationForm.astro';

const practiceAreas = (await getCollection('practice-areas')).sort(
  (a, b) => a.data.order - b.data.order
);

const categories = ['Transactional & Advisory', 'Disputes & Recovery', 'Regulatory & IP'] as const;
---

<BaseLayout
  title="Practice Areas | Corporate & Litigation Services Lucknow"
  description="Explore Zodiac Legal's 9 practice areas in Lucknow: Corporate Law, Commercial Contracts, Startups, Arbitration, UP-RERA, NCLT/DRT, IP, Labour & Taxation."
  canonicalPath="/practice-areas/"
  lastReviewed="2026-10-16"
>
  <section class="hero-obsidian-glow py-14 text-white border-b border-zinc-800">
    <div class="mx-auto max-w-container px-4 sm:px-6 lg:px-8">
      <Breadcrumbs
        items={[{ label: 'Practice Areas', href: '/practice-areas/' }]}
        invertText={true}
      />
      <p class="text-xs font-semibold tracking-widest text-amber-400 uppercase">
        Scope of Representation
      </p>
      <h1 class="mt-2 font-serif text-3xl font-semibold text-white sm:text-4xl">
        Practice Areas &amp; Statutory Desks
      </h1>
      <p class="mt-4 max-w-3xl text-base leading-relaxed text-stone-300">
        Each practice desk combines statutory advisory, contract and pleading drafting, and
        structured representation before courts, tribunals, and regulatory authorities in Lucknow
        and Uttar Pradesh.
      </p>
    </div>
  </section>

  <section class="py-16">
    <div class="mx-auto max-w-container px-4 sm:px-6 lg:px-8 space-y-16">
      {
        categories.map((cat) => {
          const items = practiceAreas.filter((area) => area.data.category === cat);
          return (
            <div>
              <div class="border-b border-border-strong pb-3">
                <p class="text-xs font-semibold tracking-widest text-brass uppercase">
                  Practice Group
                </p>
                <h2 class="mt-1 font-serif text-2xl font-semibold text-content-primary">{cat}</h2>
              </div>
              <div class="mt-8 grid grid-cols-1 gap-6 md:grid-cols-3">
                {items.map((area) => (
                  <article class="card-surface flex flex-col justify-between rounded border border-border-subtle bg-paper-card p-6 hover:border-border-strong">
                    <div>
                      <h3 class="font-serif text-xl font-semibold text-content-primary">
                        <a href={`/practice-areas/${area.slug}/`} class="hover:text-brass">
                          {area.data.title}
                        </a>
                      </h3>
                      <p class="mt-3 text-sm leading-relaxed text-content-secondary">
                        {area.data.directAnswer}
                      </p>
                      <div class="mt-4">
                        <p class="text-xs font-semibold text-content-primary">Primary Statutes:</p>
                        <ul class="mt-1.5 space-y-1 text-xs text-content-muted">
                          {area.data.statutesCovered.slice(0, 3).map((st) => (
                            <li>• {st}</li>
                          ))}
                        </ul>
                      </div>
                    </div>
                    <div class="mt-6 border-t border-border-subtle pt-4">
                      <a
                        href={`/practice-areas/${area.slug}/`}
                        class="text-xs font-semibold tracking-wider text-brass uppercase hover:underline"
                      >
                        View Process, Documents &amp; FAQs →
                      </a>
                    </div>
                  </article>
                ))}
              </div>
            </div>
          );
        })
      }

      <div class="border-t border-border-subtle pt-12">
        <div class="mx-auto max-w-3xl">
          <ConsultationForm />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
