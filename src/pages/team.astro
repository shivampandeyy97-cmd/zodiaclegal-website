---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import TeamSection from '../components/TeamSection.astro';
import ConsultationForm from '../components/ConsultationForm.astro';
import { SITE_CONFIG } from '../data/siteConfig';

const members = (await getCollection('team')).sort((a, b) => a.data.order - b.data.order);

const teamSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Zodiac Legal Leadership & Legal Team',
  itemListElement: members.map((member, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    item: {
      '@type': 'Person',
      name: member.data.name,
      jobTitle: member.data.role,
      image: new URL(member.data.image, SITE_CONFIG.url).toString(),
      worksFor: {
        '@id': `${SITE_CONFIG.url}/#legalservice`,
      },
      description: member.data.summary,
    },
  })),
};
---

<BaseLayout
  title="Our Team — Shalini Pandey, Sakshi Pandey, Shiv Kumar Pandey"
  description="Meet the Zodiac Legal leadership team: Shalini Pandey (Head), Sakshi Pandey (Legal Assistant), and Shiv Kumar Pandey (Principal Advisor)."
  canonicalPath="/team/"
  lastReviewed="2026-10-16"
  extraSchema={teamSchema}
>
  <section class="hero-obsidian-glow py-14 text-white border-b border-zinc-800">
    <div class="mx-auto max-w-container px-4 sm:px-6 lg:px-8">
      <Breadcrumbs items={[{ label: 'Our Team', href: '/team/' }]} invertText={true} />
      <p class="text-xs font-bold tracking-widest text-amber-400 uppercase">
        Leadership, Counsel &amp; Legal Operations
      </p>
      <h1 class="mt-2 font-serif text-3xl font-semibold text-white sm:text-4xl">
        Meet the <span class="brand-gradient-text">Zodiac Legal</span> Team
      </h1>
      <p class="mt-4 max-w-3xl text-base leading-relaxed text-zinc-300">
        Led by Head of Practice <strong>Shalini Pandey</strong>, Principal Advisor{' '}
        <strong>Shiv Kumar Pandey</strong>, and Legal Assistant <strong>Sakshi Pandey</strong>, our
        practice desks deliver disciplined corporate, commercial contract, RERA, and litigation
        support across India.
      </p>
    </div>
  </section>

  <!-- Full-Detail Team Section -->
  <TeamSection showFullDetails={true} />

  <section class="py-16 bg-paper">
    <div class="mx-auto max-w-container px-4 sm:px-6 lg:px-8 space-y-10">
      <div
        class="rounded border-s-4 border-orange-500 bg-paper-warm p-6 text-xs leading-relaxed text-content-secondary"
      >
        <p class="font-semibold text-content-primary">
          Regulatory Note on Bar Council of India Rule 36 Compliance:
        </p>
        <p class="mt-1">
          In adherence to Rule 36 of the Bar Council of India Rules, team profiles state factual
          roles and practice areas without comparative claims or solicitation. Individual
          vakalatnama and State Bar Council enrolment particulars are furnished directly upon formal
          instruction at {SITE_CONFIG.name}.
        </p>
      </div>

      <div class="mx-auto max-w-3xl pt-4">
        <ConsultationForm />
      </div>
    </div>
  </section>
</BaseLayout>
