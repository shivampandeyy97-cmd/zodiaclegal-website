---
import { getCollection } from 'astro:content';

interface Props {
  showFullDetails?: boolean;
}

const { showFullDetails = false } = Astro.props;
const teamMembers = (await getCollection('team')).sort((a, b) => a.data.order - b.data.order);
---

<section
  id="team-section"
  class="relative overflow-hidden border-b border-border-subtle bg-ink py-20 text-white"
>
  <!-- Ambient Orange & Solar Yellow Backdrop Glow -->
  <div
    class="pointer-events-none absolute inset-0 opacity-90"
    style="background: radial-gradient(circle at 15% 20%, rgba(234, 88, 12, 0.18) 0%, transparent 45%), radial-gradient(circle at 85% 80%, rgba(250, 204, 21, 0.12) 0%, transparent 45%);"
    aria-hidden="true"
  >
  </div>

  <div class="relative mx-auto max-w-container px-4 sm:px-6 lg:px-8">
    <div
      class="flex flex-col items-start justify-between gap-6 border-b border-zinc-800 pb-8 md:flex-row md:items-end"
    >
      <div>
        <div
          class="inline-flex items-center gap-2 rounded-full border border-orange-500/40 bg-orange-500/10 px-3.5 py-1 text-xs font-bold tracking-widest text-amber-400 uppercase"
        >
          <span class="h-2 w-2 rounded-full bg-amber-400" aria-hidden="true"></span>
          <span>Leadership &amp; Legal Team</span>
        </div>
        <h2 class="mt-3 font-serif text-3xl font-semibold tracking-tight text-white sm:text-4xl">
          The Minds Behind <span class="brand-gradient-text">Zodiac Legal</span>
        </h2>
        <p class="mt-2.5 max-w-2xl text-sm leading-relaxed text-zinc-300 sm:text-base">
          Dedicated legal leadership and advisory counsel in Vikas Nagar, Lucknow, guiding
          businesses and individuals through corporate law, contracts, UP-RERA, and dispute
          resolution.
        </p>
      </div>

      {
        !showFullDetails && (
          <a
            href="/team/"
            class="inline-flex items-center gap-2 rounded-sm border border-amber-400/50 bg-zinc-900/90 px-5 py-2.5 text-xs font-bold tracking-wider text-amber-300 uppercase transition-all hover:border-amber-400 hover:bg-orange-600 hover:text-white"
          >
            <span>View Full Team Profiles</span>
            <span aria-hidden="true">→</span>
          </a>
        )
      }
    </div>

    <!-- 3-Column Executive Portrait Grid -->
    <div class="mt-12 grid grid-cols-1 gap-8 md:grid-cols-3">
      {
        teamMembers.map((member) => (
          <article class="group relative flex flex-col justify-between overflow-hidden rounded-md border border-zinc-800 bg-zinc-900/85 p-7 transition-all duration-300 hover:-translate-y-1.5 hover:border-orange-500/80 hover:shadow-[0_20px_40px_-15px_rgba(234,88,12,0.3)]">
            <div class="brand-gradient-bar absolute inset-x-0 top-0 h-1.5" aria-hidden="true" />

            <div>
              <div class="flex flex-col items-center text-center">
                <div class="portrait-ring relative rounded-full shadow-xl transition-transform duration-300 group-hover:scale-105">
                  <div class="h-36 w-36 overflow-hidden rounded-full border-4 border-zinc-950 bg-zinc-800 sm:h-40 sm:w-40">
                    <img
                      src={member.data.image}
                      alt={`${member.data.name} — ${member.data.role} at Zodiac Legal`}
                      width="235"
                      height="235"
                      loading="lazy"
                      class="h-full w-full object-cover object-center"
                    />
                  </div>
                </div>

                <span class="mt-4 inline-block rounded-full border border-amber-400/40 bg-gradient-to-r from-orange-600/20 to-amber-500/20 px-4 py-1 text-xs font-bold tracking-widest text-amber-300 uppercase">
                  {member.data.role}
                </span>

                <h3 class="mt-2.5 font-serif text-2xl font-semibold text-white group-hover:text-amber-300">
                  {member.data.name}
                </h3>

                <p class="mt-1 text-xs font-medium tracking-wide text-orange-400">
                  {member.data.desk}
                </p>

                <p class="mt-4 text-sm leading-relaxed text-zinc-300">{member.data.summary}</p>
              </div>

              <div class="mt-6 border-t border-zinc-800/90 pt-5">
                <p class="text-[11px] font-bold tracking-widest text-amber-400 uppercase">
                  Key Focus Areas
                </p>
                <ul class="mt-2.5 space-y-1.5 text-xs text-zinc-300">
                  {member.data.practiceFocus.map((focus) => (
                    <li class="flex items-start gap-2">
                      <span class="text-orange-500 font-bold" aria-hidden="true">
                        ▸
                      </span>
                      <span>{focus}</span>
                    </li>
                  ))}
                </ul>
              </div>

              {showFullDetails && (
                <div class="mt-5 border-t border-zinc-800/90 pt-4">
                  <p class="text-[11px] font-bold tracking-widest text-amber-400 uppercase">
                    Forums &amp; Languages
                  </p>
                  <ul class="mt-2 space-y-1 text-xs text-zinc-400">
                    {member.data.forums.map((forum) => (
                      <li>• {forum}</li>
                    ))}
                    <li class="pt-1 text-zinc-300">
                      <strong>Languages:</strong> {member.data.languages.join(', ')}
                    </li>
                  </ul>
                </div>
              )}
            </div>

            <div class="mt-6 border-t border-zinc-800 pt-4 flex items-center justify-between text-xs">
              <span class="text-zinc-400">Lucknow Desk</span>
              <a
                href="/contact/#consultation-form"
                class="font-bold tracking-wider text-amber-400 uppercase hover:text-orange-400 hover:underline"
              >
                Consult Desk →
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
