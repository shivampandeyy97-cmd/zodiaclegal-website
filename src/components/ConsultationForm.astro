---
import { PRACTICE_AREAS_NAV, SITE_CONFIG } from '../data/siteConfig';

interface Props {
  defaultPracticeArea?: string;
  compact?: boolean;
}

const { defaultPracticeArea = '', compact = false } = Astro.props;
const apiUrl = import.meta.env.PUBLIC_API_URL || 'https://zodiaclegal-api.onrender.com';
---

<div
  id="consultation-form"
  class="card-surface relative overflow-hidden rounded-md border border-border-strong bg-paper-card p-5 shadow-md sm:p-8"
>
  <div class="brand-gradient-bar absolute inset-x-0 top-0 h-1.5" aria-hidden="true"></div>
  <div class="border-b border-border-subtle pb-4">
    <p class="text-xs font-bold tracking-widest text-brass uppercase">
      Confidential Consultation Request • Pan-India Desk
    </p>
    <h2 class="mt-1 font-serif text-xl font-semibold text-content-primary sm:text-2xl">
      Schedule a Legal Consultation
    </h2>
    <p class="mt-1.5 text-sm text-content-secondary">
      Provide brief background details so our corporate &amp; litigation desk (<span
        class="font-medium text-content-primary">{SITE_CONFIG.nap.email}</span
      >) can perform a preliminary conflict check and coordinate an appointment.
    </p>
  </div>

  <form
    id="zl-consult-form"
    action={`${apiUrl}/api/consult`}
    data-recipient={SITE_CONFIG.nap.email}
    data-whatsapp={SITE_CONFIG.nap.whatsappNumber}
    method="POST"
    class="mt-6 space-y-5"
    novalidate
  >
    <!-- Anti-spam Honeypot Field (Hidden from assistive tech and visual layout) -->
    <div class="hidden" aria-hidden="true">
      <label for="zl-company-website">Company Website (Leave blank)</label>
      <input
        type="text"
        id="zl-company-website"
        name="website_url"
        tabindex="-1"
        autocomplete="off"
      />
    </div>

    <div class:list={['grid gap-5', compact ? 'grid-cols-1' : 'grid-cols-1 sm:grid-cols-2']}>
      <div>
        <label
          for="zl-full-name"
          class="block text-xs font-bold tracking-wide text-content-primary uppercase"
        >
          Full Name <span class="text-orange-600" aria-hidden="true">*</span>
        </label>
        <input
          type="text"
          id="zl-full-name"
          name="fullName"
          required
          minlength="2"
          maxlength="120"
          autocomplete="name"
          placeholder="e.g., Rajeshwar Prasad"
          class="mt-1.5 w-full rounded-sm border border-border-strong bg-paper px-3.5 py-2.5 text-base text-content-primary focus:border-orange-500 focus:outline-none sm:text-sm [&:user-invalid]:border-red-600 [&:user-valid]:border-emerald-600"
        />
      </div>

      <div>
        <label
          for="zl-phone"
          class="block text-xs font-bold tracking-wide text-content-primary uppercase"
        >
          Phone / WhatsApp Number <span class="text-orange-600" aria-hidden="true">*</span>
        </label>
        <input
          type="tel"
          id="zl-phone"
          name="phone"
          required
          pattern="^[0-9+\\-\\s()]{8,20}$"
          autocomplete="tel"
          placeholder="+91 98XXX XXXXX"
          class="mt-1.5 w-full rounded-sm border border-border-strong bg-paper px-3.5 py-2.5 text-base text-content-primary focus:border-orange-500 focus:outline-none sm:text-sm [&:user-invalid]:border-red-600 [&:user-valid]:border-emerald-600"
        />
      </div>
    </div>

    <div class:list={['grid gap-5', compact ? 'grid-cols-1' : 'grid-cols-1 sm:grid-cols-2']}>
      <div>
        <label
          for="zl-email"
          class="block text-xs font-bold tracking-wide text-content-primary uppercase"
        >
          Email Address <span class="text-orange-600" aria-hidden="true">*</span>
        </label>
        <input
          type="email"
          id="zl-email"
          name="email"
          required
          autocomplete="email"
          placeholder="name@company.com"
          class="mt-1.5 w-full rounded-sm border border-border-strong bg-paper px-3.5 py-2.5 text-base text-content-primary focus:border-orange-500 focus:outline-none sm:text-sm [&:user-invalid]:border-red-600 [&:user-valid]:border-emerald-600"
        />
      </div>

      <div>
        <label
          for="zl-organization"
          class="block text-xs font-bold tracking-wide text-content-primary uppercase"
        >
          Company / Organization <span class="text-content-muted font-normal">(Optional)</span>
        </label>
        <input
          type="text"
          id="zl-organization"
          name="organization"
          maxlength="140"
          autocomplete="organization"
          placeholder="Entity name or individual matter"
          class="mt-1.5 w-full rounded-sm border border-border-strong bg-paper px-3.5 py-2.5 text-base text-content-primary focus:border-orange-500 focus:outline-none sm:text-sm"
        />
      </div>
    </div>

    <div>
      <label
        for="zl-practice-area"
        class="block text-xs font-bold tracking-wide text-content-primary uppercase"
      >
        Relevant Practice Area <span class="text-orange-600" aria-hidden="true">*</span>
      </label>
      <select
        id="zl-practice-area"
        name="practiceArea"
        required
        class="mt-1.5 w-full rounded-sm border border-border-strong bg-paper px-3.5 py-2.5 text-base text-content-primary focus:border-orange-500 focus:outline-none sm:text-sm [&:user-invalid]:border-red-600 [&:user-valid]:border-emerald-600"
      >
        <option value="" disabled selected={!defaultPracticeArea}>
          Select a practice area...
        </option>
        {
          PRACTICE_AREAS_NAV.map((area) => (
            <option value={area.slug} selected={defaultPracticeArea === area.slug}>
              {area.title}
            </option>
          ))
        }
        <option value="other">Other Corporate / Statutory Matter</option>
      </select>
    </div>

    <div>
      <label
        for="zl-message"
        class="block text-xs font-bold tracking-wide text-content-primary uppercase"
      >
        Brief Matter Overview (Non-Confidential Summary) <span
          class="text-orange-600"
          aria-hidden="true">*</span
        >
      </label>
      <textarea
        id="zl-message"
        name="message"
        rows="4"
        required
        minlength="20"
        maxlength="2500"
        placeholder="State the nature of the transaction, contract, or dispute, the relevant judicial or regulatory forum in India, and any statutory deadline..."
        class="mt-1.5 w-full rounded-sm border border-border-strong bg-paper px-3.5 py-2.5 text-base text-content-primary focus:border-orange-500 focus:outline-none sm:text-sm [&:user-invalid]:border-red-600 [&:user-valid]:border-emerald-600"
      ></textarea>
    </div>

    <div class="flex items-start gap-2.5">
      <input
        type="checkbox"
        id="zl-bci-consent"
        name="bciConsent"
        value="accepted"
        required
        class="mt-1 h-4 w-4 shrink-0 rounded border-border-strong text-orange-600 focus:ring-orange-500"
      />
      <label for="zl-bci-consent" class="text-xs leading-relaxed text-content-secondary">
        I confirm that this inquiry is made of my own volition to seek information or schedule a
        consultation with {SITE_CONFIG.name}, and I understand that submitting this form does not
        create an advocate-client relationship until a formal engagement is executed.
      </label>
    </div>

    <!-- Accessible Status Banner -->
    <div
      id="zl-form-status"
      role="status"
      aria-live="polite"
      hidden
      class="rounded border p-3.5 text-sm"
    >
      <div class="flex items-start gap-2.5">
        <span id="zl-form-status-icon" aria-hidden="true" class="font-bold"></span>
        <div class="space-y-2">
          <p id="zl-form-status-text" class="font-medium"></p>
          <div id="zl-form-actions" hidden class="flex flex-wrap gap-2.5 pt-1">
            <a
              id="zl-direct-email-link"
              href={`mailto:${SITE_CONFIG.nap.email}`}
              class="inline-flex items-center gap-1.5 rounded bg-orange-600 px-3 py-1.5 text-xs font-bold text-white hover:bg-orange-700"
            >
              <span>✉ Send Copy via Email App ({SITE_CONFIG.nap.email})</span>
            </a>
            <a
              id="zl-direct-wa-link"
              href={`https://wa.me/${SITE_CONFIG.nap.whatsappNumber}`}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 rounded border border-current px-3 py-1.5 text-xs font-bold hover:underline"
            >
              <span>Share on WhatsApp ({SITE_CONFIG.nap.phoneDisplay})</span>
            </a>
          </div>
        </div>
      </div>
    </div>

    <div class="flex flex-col justify-between gap-3 pt-1 sm:flex-row sm:items-center">
      <button
        type="submit"
        id="zl-submit-btn"
        class="btn-primary w-full rounded-sm bg-gradient-to-r from-orange-600 via-orange-500 to-amber-500 px-6 py-3 text-xs font-bold tracking-wider text-white uppercase shadow-md transition-all hover:from-amber-400 hover:to-yellow-300 hover:text-black sm:w-auto"
      >
        Submit Consultation Request
      </button>
      <p class="text-xs text-content-muted">
        Direct Desk:{' '}
        <a href={`mailto:${SITE_CONFIG.nap.email}`} class="font-bold text-brass underline">
          {SITE_CONFIG.nap.email}
        </a>
      </p>
    </div>
  </form>
</div>

<script is:inline>
  (() => {
    const form = document.getElementById('zl-consult-form');
    const statusBox = document.getElementById('zl-form-status');
    const statusIcon = document.getElementById('zl-form-status-icon');
    const statusText = document.getElementById('zl-form-status-text');
    const statusActions = document.getElementById('zl-form-actions');
    const directEmailLink = document.getElementById('zl-direct-email-link');
    const directWaLink = document.getElementById('zl-direct-wa-link');
    const submitBtn = document.getElementById('zl-submit-btn');

    if (!form || !(form instanceof HTMLFormElement)) return;

    const recipientEmail = form.dataset.recipient || 'zodiaclegal.lucknow@gmail.com';
    const whatsappNumber = form.dataset.whatsapp || '919839010163';

    function prepareDirectLinks(payload) {
      const subject = `[Consultation Inquiry] ${payload.practiceArea} — ${payload.fullName}`;
      const bodyLines = [
        `Zodiac Legal Consultation Inquiry`,
        `---------------------------------`,
        `Full Name: ${payload.fullName}`,
        `Organization: ${payload.organization || 'Not specified'}`,
        `Phone / WhatsApp: ${payload.phone}`,
        `Email: ${payload.email}`,
        `Practice Area: ${payload.practiceArea}`,
        ``,
        `Matter Overview:`,
        payload.message,
      ].join('\n');

      if (directEmailLink instanceof HTMLAnchorElement) {
        directEmailLink.href = `mailto:${recipientEmail}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(bodyLines)}`;
      }
      if (directWaLink instanceof HTMLAnchorElement) {
        directWaLink.href = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(bodyLines)}`;
      }
      if (statusActions) {
        statusActions.hidden = false;
      }
    }

    function showStatus(type, message, showLinks = false) {
      if (!statusBox || !statusIcon || !statusText) return;
      statusBox.hidden = false;
      if (statusActions) {
        statusActions.hidden = !showLinks;
      }
      if (type === 'error') {
        statusBox.className =
          'rounded border border-red-800 bg-red-50 p-3.5 text-sm text-red-900 dark:bg-red-950/60 dark:text-red-200';
        statusIcon.textContent = '⚠';
      } else {
        statusBox.className =
          'rounded border border-green-800 bg-green-50 p-3.5 text-sm text-green-900 dark:bg-green-950/60 dark:text-green-200';
        statusIcon.textContent = '✓';
      }
      statusText.textContent = message;
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      const data = new FormData(form);
      const fullName = String(data.get('fullName') || '').trim();
      const phone = String(data.get('phone') || '').trim();
      const email = String(data.get('email') || '').trim();
      const organization = String(data.get('organization') || '').trim();
      const practiceArea = String(data.get('practiceArea') || '').trim();
      const message = String(data.get('message') || '').trim();
      const bciConsent = data.get('bciConsent');

      if (fullName.length < 2) {
        showStatus('error', 'Please enter your full name (minimum 2 characters).');
        return;
      }
      if (!/^[0-9+\-\s()]{8,20}$/.test(phone)) {
        showStatus('error', 'Please enter a valid 10-digit Indian mobile or landline number.');
        return;
      }
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        showStatus('error', 'Please enter a valid email address.');
        return;
      }
      if (!practiceArea) {
        showStatus('error', 'Please select the relevant practice area.');
        return;
      }
      if (message.length < 20) {
        showStatus('error', 'Please provide a brief matter overview (at least 20 characters).');
        return;
      }
      if (!bciConsent) {
        showStatus('error', 'Please acknowledge the Bar Council of India non-solicitation notice.');
        return;
      }

      if (submitBtn instanceof HTMLButtonElement) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Submitting Request...';
      }

      const payload = {
        fullName,
        phone,
        email,
        organization,
        practiceArea,
        message,
        bciConsent: String(bciConsent),
        website_url: String(data.get('website_url') || ''),
      };

      prepareDirectLinks(payload);

      const isLocal =
        window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1';
      const targetEndpoint = isLocal ? 'http://localhost:8787/api/consult' : form.action;

      try {
        // Also dispatch a non-blocking client-side notification to FormSubmit for zodiaclegal.lucknow@gmail.com
        if (!isLocal && !payload.website_url) {
          fetch(`https://formsubmit.co/ajax/${encodeURIComponent(recipientEmail)}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify({
              _subject: `[Zodiac Legal Inquiry] ${practiceArea} — ${fullName}`,
              _replyto: email,
              _template: 'table',
              Full_Name: fullName,
              Organization: organization || 'Not specified',
              Phone_WhatsApp: phone,
              Client_Email: email,
              Practice_Area: practiceArea,
              Matter_Overview: message,
            }),
          }).catch(() => {});
        }

        const response = await fetch(targetEndpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(payload),
        });

        const result = await response.json().catch(() => ({}));
        if (!response.ok) {
          throw new Error(result.error || 'Unable to process request right now.');
        }

        showStatus(
          'success',
          result.message ||
            `Thank you. Your consultation inquiry has been logged and routed to ${recipientEmail}. Our corporate desk will respond within one business day.`,
          true
        );
        form.reset();
      } catch (err) {
        showStatus(
          'error',
          err instanceof Error && err.message && !err.message.includes('Failed to fetch')
            ? err.message
            : `Please click the button below to dispatch your inquiry directly to ${recipientEmail} or call +91 98390 10163.`,
          true
        );
      } finally {
        if (submitBtn instanceof HTMLButtonElement) {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Submit Consultation Request';
        }
      }
    });
  })();
</script>
