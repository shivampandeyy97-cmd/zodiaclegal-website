---
import { SITE_CONFIG } from '../data/siteConfig';
---

<dialog
  id="bci-disclaimer-modal"
  aria-labelledby="bci-modal-title"
  aria-describedby="bci-modal-desc"
  class="relative m-auto max-w-xl overflow-hidden rounded-md border border-border-strong bg-paper p-6 text-content-primary shadow-2xl sm:p-8"
>
  <div class="brand-gradient-bar absolute inset-x-0 top-0 h-1.5" aria-hidden="true"></div>
  <div class="flex items-start justify-between gap-4 border-b border-border-subtle pb-4">
    <div>
      <p class="text-xs font-bold tracking-widest text-brass uppercase">
        Bar Council of India Compliance Notice
      </p>
      <h2 id="bci-modal-title" class="mt-1 font-serif text-xl font-semibold text-content-primary">
        Regulatory Disclaimer &amp; User Acknowledgement
      </h2>
    </div>
    <img
      src="/brand/logo.png"
      alt="Zodiac Legal"
      width="110"
      height="55"
      class="h-10 w-auto rounded bg-white p-1 shadow-sm"
    />
  </div>

  <div id="bci-modal-desc" class="mt-4 space-y-3 text-sm leading-relaxed text-content-secondary">
    <p>
      Under <strong>Rule 36, Chapter II, Part VI of the Bar Council of India Rules</strong> (framed under
      the Advocates Act, 1961) and the observations of the Hon’ble Supreme Court of India in
      <em>Bar Council of India v. A.K. Balaji</em>, advocates in India are not permitted to solicit
      work or advertise directly or indirectly.
    </p>
    <p>By clicking <strong>“I Acknowledge &amp; Proceed”</strong> below, you confirm that:</p>
    <ul class="list-disc space-y-1.5 ps-5 text-xs sm:text-sm">
      <li>
        You are accessing <code class="font-mono text-xs">zodiaclegal.com</code> of your own accord to
        obtain factual information about <strong>{SITE_CONFIG.name}</strong>, its practice areas,
        and its statutory guides.
      </li>
      <li>
        There has been no advertisement, personal communication, solicitation, invitation, or
        inducement of any sort whatsoever from {SITE_CONFIG.name} or any of its members.
      </li>
      <li>
        Reading information on this website or submitting a consultation request does not create an
        advocate-client relationship, nor does the content constitute formal legal advice.
      </li>
    </ul>
  </div>

  <div
    class="mt-6 flex flex-wrap items-center justify-end gap-3 border-t border-border-subtle pt-4"
  >
    <a
      href="/disclaimer/"
      class="rounded px-3 py-2 text-xs font-semibold text-content-secondary underline hover:text-brass"
    >
      Read Full Disclaimer
    </a>
    <button
      type="button"
      id="bci-accept-btn"
      class="btn-primary rounded-sm bg-gradient-to-r from-orange-600 via-orange-500 to-amber-500 px-5 py-2.5 text-xs font-bold tracking-wider text-white uppercase shadow-md transition-all hover:from-amber-400 hover:to-yellow-300 hover:text-black"
    >
      I Acknowledge &amp; Proceed
    </button>
  </div>
</dialog>

<script is:inline>
  (() => {
    const STORAGE_KEY = 'zodiaclegal_bci_acknowledged_v1';
    const dialog = document.getElementById('bci-disclaimer-modal');
    const acceptBtn = document.getElementById('bci-accept-btn');
    if (!dialog || !(dialog instanceof HTMLDialogElement)) return;

    const params = new URLSearchParams(window.location.search);
    const skipForAudit = params.get('bci') === 'accepted' || navigator.webdriver === true;

    try {
      const acknowledged = localStorage.getItem(STORAGE_KEY) === 'true';
      if (!acknowledged && !skipForAudit) {
        dialog.showModal();
      }
    } catch {
      // Ignore storage access errors in restricted contexts
    }

    if (acceptBtn) {
      acceptBtn.addEventListener('click', () => {
        try {
          localStorage.setItem(STORAGE_KEY, 'true');
        } catch {
          // Ignore
        }
        dialog.close();
      });
    }
  })();
</script>
