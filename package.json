{
  "name": "zodiaclegal-website",
  "version": "1.0.0",
  "private": true,
  "description": "Official website for Zodiac Legal — Advocates & Corporate Counsel in Lucknow, Uttar Pradesh (Astro 5 + Tailwind CSS + Hono Consultation Service)",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview --port 4321 --host",
    "astro": "astro",
    "typecheck": "astro check && tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run server/",
    "test:e2e": "playwright test",
    "test": "npm run test:unit && npm run test:e2e",
    "server:dev": "node --watch server/index.mjs",
    "server:start": "node server/index.mjs",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.2.0",
    "@astrojs/rss": "^4.0.11",
    "@astrojs/sitemap": "^3.3.0",
    "@astrojs/tailwind": "^6.0.0",
    "@fontsource-variable/inter": "^5.2.5",
    "@fontsource-variable/newsreader": "^5.2.5",
    "astro": "^5.5.0",
    "hono": "^4.7.4",
    "@hono/node-server": "^1.13.8",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@playwright/test": "^1.51.0",
    "@types/node": "^22.13.10",
    "eslint": "^9.22.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.0",
    "prettier": "^3.5.3",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  },
  "lint-staged": {
    "*.{js,ts,mjs,astro,md,json,css}": [
      "prettier --write"
    ]
  }
}
